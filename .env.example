# QUANTEX - Environment Variables Template
# Copy this file to .env and configure your keys if available.

FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=quantex-secure-key-replace-in-production

# Google Gemini API (Optional: If omitted, QUANTEX runs using intelligent local quantitative fallbacks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Virtual Paper Trading Initial Capital (INR 10,00,000)
INITIAL_CAPITAL=1000000.0
TRANSACTION_FEE_PCT=0.001
SLIPPAGE_PCT=0.0005

# Cache duration for market data (seconds)
CACHE_TTL_SECONDS=300
